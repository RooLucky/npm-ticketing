{
  "name": "@quanby/ticketing-mock-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace=@quanby/ticketing-contracts",
    "dev": "tsx watch src/index.ts",
    "prestart": "npm run build --workspace=@quanby/ticketing-contracts",
    "start": "node dist/index.js",
    "prebuild": "npm run build --workspace=@quanby/ticketing-contracts",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "pretypecheck": "npm run build --workspace=@quanby/ticketing-contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace=@quanby/ticketing-contracts",
    "test": "vitest run",
    "pretest:coverage": "npm run build --workspace=@quanby/ticketing-contracts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@quanby/ticketing-contracts": "*",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.5.0",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.20.3"
  }
}
